# ==========================================
# DCMS Core Configuration
# ==========================================
NODE_ENV=production
PORT=3000

# ------------------------------------------
# DATABASE SELECTION (เลือกใช้งานอย่างใดอย่างหนึ่ง)
# ------------------------------------------
# ตัวเลือกที่ 1: SQLite (แนะนำ - เบาที่สุด ไม่กินแรม ไม่ต้องลง Server DB)
DB_TYPE=sqlite
SQLITE_FILE_PATH=./data/dcms.sqlite

# ตัวเลือกที่ 2: MySQL / MariaDB
# DB_TYPE=mysql
# DATABASE_URL=mysql://dbuser:dbpassword@127.0.0.1:3306/dcms_db

# ตัวเลือกที่ 3: PostgreSQL
# DB_TYPE=postgres
# DATABASE_URL=postgresql://postgres:postgres_secret@127.0.0.1:5432/dcms_db?schema=public
